import React, { useState, useEffect } from 'react';
import { ArrowLeft, MapPin, Star, User as UserIcon, FileText } from 'lucide-react';
import useApiConnection from '../../context/ApiConnection';

const UserProfileView = ({ user, onBack, darkMode }) => {
  const [userPosts, setUserPosts] = useState([]);
  const [userStats, setUserStats] = useState(null);
  const [loading, setLoading] = useState(false);

  // Fetch user's posts and stats
  useEffect(() => {
    const fetchUserData = async () => {
      setLoading(true);
      try {
        // Fetch user's posts
        const postsResponse = await fetch(
          `${process.env.REACT_APP_API_URL || 'http://localhost:8000/api'}/news-feed/user/${user.id}/posts`
        );
        
        if (postsResponse.ok) {
          const postsData = await postsResponse.json();
          if (postsData.status === 'success') {
            setUserPosts(postsData.posts || []);
          }
        }

        // Fetch user stats
        const statsResponse = await fetch(
          `${process.env.REACT_APP_API_URL || 'http://localhost:8000/api'}/users/${user.id}/stats`
        );
        
        if (statsResponse.ok) {
          const statsData = await statsResponse.json();
          if (statsData.status === 'success') {
            setUserStats(statsData.data);
          }
        }
      } catch (error) {
        console.error('Error fetching user data:', error);
      } finally {
        setLoading(false);
      }
    };

    if (user?.id) {
      fetchUserData();
    }
  }, [user]);



  return (
    <div className={`${darkMode ? 'bg-gray-900' : 'bg-gray-50'} h-full overflow-y-auto`}>
      {/* Header Button */}
      <div className={`sticky top-0 z-40 ${darkMode ? 'bg-gray-800 border-gray-700' : 'bg-white border-gray-200'} border-b p-4`}>
        <button
          onClick={onBack}
          className={`flex items-center gap-2 ${darkMode ? 'text-gray-300 hover:text-white' : 'text-gray-700 hover:text-gray-900'}`}
        >
          <ArrowLeft className="w-5 h-5" />
          <span>Back</span>
        </button>
      </div>

      <div className="max-w-4xl mx-auto">
        {/* Cover Photo */}
        {user.coverPhoto && (
          <div className="h-48 w-full overflow-hidden">
            <img
              src={user.coverPhoto}
              alt="Cover"
              className="w-full h-full object-cover"
            />
          </div>
        )}

        {/* Profile Section */}
        <div className={`${darkMode ? 'bg-gray-800' : 'bg-white'} p-6`}>
          <div className="flex items-start justify-between mb-4">
            {/* Avatar */}
            <div className="-mt-20 mb-4">
              <img
                src={user.avatar}
                alt={user.name}
                className="w-32 h-32 rounded-full border-4 border-green-500 object-cover"
              />
            </div>
          </div>

          {/* User Info */}
          <div className="mb-6">
            <h1 className={`text-3xl font-bold ${darkMode ? 'text-white' : 'text-gray-900'}`}>
              {user.name}
            </h1>
            <p className={`text-lg ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
              {user.username}
            </p>
          </div>

          {/* Bio */}
          {user.bio && (
            <p className={`mb-6 text-sm leading-relaxed ${darkMode ? 'text-gray-300' : 'text-gray-700'}`}>
              {user.bio}
            </p>
          )}

          {/* Location & Verification */}
          <div className="flex items-center gap-4 mb-6">
            {user.location && (
              <div className="flex items-center gap-1">
                <MapPin className="w-4 h-4 text-gray-500" />
                <span className={`text-sm ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                  {user.location}
                </span>
              </div>
            )}
            {user.isVerified && (
              <div className="bg-blue-500 text-white px-3 py-1 rounded-full text-xs font-medium">
                ✓ Verified
              </div>
            )}
          </div>

          {/* Stats Grid */}
          <div className="grid grid-cols-4 gap-4 mb-6">
            <div className={`${darkMode ? 'bg-gray-700' : 'bg-gray-100'} p-4 rounded-lg text-center`}>
              <div className={`text-2xl font-bold ${darkMode ? 'text-white' : 'text-gray-900'}`}>
                {userStats?.followers || 0}
              </div>
              <div className={`text-xs ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                Followers
              </div>
            </div>
            <div className={`${darkMode ? 'bg-gray-700' : 'bg-gray-100'} p-4 rounded-lg text-center`}>
              <div className={`text-2xl font-bold ${darkMode ? 'text-white' : 'text-gray-900'}`}>
                {userStats?.following || 0}
              </div>
              <div className={`text-xs ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                Following
              </div>
            </div>
            <div className={`${darkMode ? 'bg-gray-700' : 'bg-gray-100'} p-4 rounded-lg text-center`}>
              <div className={`text-2xl font-bold ${darkMode ? 'text-white' : 'text-gray-900'}`}>
                {userPosts.length}
              </div>
              <div className={`text-xs ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                Posts
              </div>
            </div>
            <div className={`${darkMode ? 'bg-gray-700' : 'bg-gray-100'} p-4 rounded-lg text-center`}>
              <div className="flex items-center justify-center gap-1">
                <Star className="w-5 h-5 text-yellow-400 fill-current" />
                <span className={`text-lg font-bold ${darkMode ? 'text-white' : 'text-gray-900'}`}>
                  {user.rating || 0}
                </span>
              </div>
              <div className={`text-xs ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                Rating
              </div>
            </div>
          </div>

          {/* Action Buttons */}
          <div className="flex gap-3">
            <button className={`flex-1 px-6 py-2 rounded-lg font-medium transition-colors ${
              darkMode
                ? 'bg-green-600 hover:bg-green-700 text-white'
                : 'bg-green-500 hover:bg-green-600 text-white'
            }`}>
              Follow
            </button>
            <button className={`flex-1 px-6 py-2 rounded-lg font-medium transition-colors ${
              darkMode
                ? 'bg-gray-700 hover:bg-gray-600 text-gray-300'
                : 'bg-gray-200 hover:bg-gray-300 text-gray-700'
            }`}>
              Message
            </button>
          </div>
        </div>

        {/* User Posts Section */}
        <div className={`${darkMode ? 'bg-gray-800' : 'bg-white'} m-4 rounded-lg p-6`}>
          <h2 className={`text-2xl font-bold mb-6 flex items-center gap-2 ${darkMode ? 'text-white' : 'text-gray-900'}`}>
            <FileText className="w-6 h-6" />
            All Posts ({userPosts.length})
          </h2>

          {userPosts.length > 0 ? (
            <div className="space-y-4">
              {userPosts.map((post) => (
                <div
                  key={post.id}
                  className={`${darkMode ? 'bg-gray-700' : 'bg-gray-50'} p-4 rounded-lg border ${
                    darkMode ? 'border-gray-600' : 'border-gray-200'
                  }`}
                >
                  <h3 className={`text-lg font-semibold mb-2 ${darkMode ? 'text-white' : 'text-gray-900'}`}>
                    {post.title}
                  </h3>
                  <p className={`text-sm mb-3 ${darkMode ? 'text-gray-300' : 'text-gray-700'}`}>
                    {post.description}
                  </p>
                  {post.images && post.images.length > 0 && (
                    <img
                      src={post.images[0]}
                      alt={post.title}
                      className="w-full h-48 object-cover rounded-lg mb-3"
                    />
                  )}
                  <div className="flex items-center justify-between text-sm">
                    <span className={`${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                      {post.created_at}
                    </span>
                    <div className="flex gap-4">
                      <span className={`${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                        ❤️ {post.likes || 0}
                      </span>
                      <span className={`${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
                        💬 {post.comments || 0}
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className={`text-center py-12 ${darkMode ? 'text-gray-400' : 'text-gray-600'}`}>
              <FileText className="w-12 h-12 mx-auto mb-3 opacity-50" />
              <p>No posts yet</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default UserProfileView;